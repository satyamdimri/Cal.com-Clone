{
  "version": 2,
  "functions": {
    "api/[[...path]].js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[[...path]].js"
    },
    {
      "src": "/health",
      "dest": "/api/[[...path]].js"
    },
    {
      "src": "/event-types",
      "dest": "/api/[[...path]].js"
    },
    {
      "src": "/availability",
      "dest": "/api/[[...path]].js"
    },
    {
      "src": "/availability/(.*)",
      "dest": "/api/[[...path]].js"
    },
    {
      "src": "/bookings",
      "dest": "/api/[[...path]].js"
    },
    {
      "src": "/bookings/(.*)",
      "dest": "/api/[[...path]].js"
    },
    {
      "src": "/public/(.*)",
      "dest": "/api/[[...path]].js"
    }
  ]
}
